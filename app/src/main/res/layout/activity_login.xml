<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_gradient">

    <LinearLayout
        android:id="@+id/loginContentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logo with Real Ambient Glow (Borderless Transparent Logo) -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center">

            <!-- Real Cyan/Blue Ambient Glow Aura -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_brand_radial_glow"
                android:importantForAccessibility="no" />

            <!-- Transparent StudyTimer Hourglass Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo_transparent"
                android:scaleType="fitCenter"
                android:contentDescription="StudyTimer Logo" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyTimer"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Master your focus"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:letterSpacing="0.01"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Grouped Action Buttons -->
        <!-- 1. Google Sign In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Continue with Google"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="26dp"
            app:backgroundTint="#FFFFFF"
            app:icon="@drawable/ic_google_logo"
            app:iconTint="@null"
            app:iconSize="20dp"
            app:iconPadding="12dp"
            app:iconGravity="textStart"
            app:elevation="2dp" />

        <!-- 2. Continue as Guest Button (Zero-friction start) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuest"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="Continue as Guest"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="25dp"
            app:backgroundTint="#141C2E"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:rippleColor="#20FFFFFF" />

        <!-- 3. In-App Browser Sign-In (Trouble signing in fallback) -->
        <TextView
            android:id="@+id/btnBrowserSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center"
            android:text="Trouble signing in?"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <!-- Bottom Grounded Section: Terms & Legal Notice -->
        <TextView
            android:id="@+id/tvLegalNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:gravity="center"
            android:lineSpacingExtra="2.5dp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
