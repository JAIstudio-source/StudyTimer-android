<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widMatrixRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/widMatrixHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widMatrixTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOAL MATRIX"
                android:textColor="#A78BFA"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widMatrixSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="General"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widMatrixStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0d streak"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Numbers and Target -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widMatrixFocusTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0h 00m"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widMatrixTargetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Daily goal: 2h 00m (0%)"
                android:textColor="#75FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widMatrixActionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap to start timer"
                android:textColor="#A78BFA"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Generated Micro-Matrix Grid Bitmap -->
        <ImageView
            android:id="@+id/widMatrixCanvas"
            android:layout_width="120dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
