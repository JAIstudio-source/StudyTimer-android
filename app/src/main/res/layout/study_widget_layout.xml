<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/widHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- App Branding & Active Subject -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDYTIMER"
                android:textColor="#A78BFA"
                android:textSize="11.5sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• General"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Streak Badge Capsule -->
        <TextView
            android:id="@+id/widStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🔥 0d streak"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Stats on Left, Actions on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Stats Area (Clickable to open app) -->
        <LinearLayout
            android:id="@+id/widStatsCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widTodayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S FOCUS"
                android:textColor="#75FFFFFF"
                android:textSize="9.5sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0h 00m"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <!-- Daily Goal Progress Bar -->
            <ProgressBar
                android:id="@+id/widProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_track" />

            <TextView
                android:id="@+id/widGoalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Goal: 2h 00m"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Right Controls Area -->
        <LinearLayout
            android:id="@+id/widControlsCol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Primary Action (Start / Pause / Resume) -->
            <TextView
                android:id="@+id/widToggle"
                android:layout_width="114dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_widget_btn_primary"
                android:gravity="center"
                android:text="START FOCUS"
                android:textColor="#181826"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:clickable="true" />

            <!-- Secondary Action (Stop / End Session) -->
            <TextView
                android:id="@+id/widStop"
                android:layout_width="114dp"
                android:layout_height="29dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_widget_btn_danger"
                android:gravity="center"
                android:text="END SESSION"
                android:textColor="#FF6B6B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:clickable="true" />

            <!-- Status indicator text when active -->
            <TextView
                android:id="@+id/widStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ready when you are"
                android:textColor="#77FFFFFF"
                android:textSize="9.5sp"
                android:gravity="center"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
