<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF121212"
    android:padding="14dp">

    <TextView
        android:id="@+id/widTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StudyTimer"
        android:textColor="#FF7DD3FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widToday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="Today  0h 0m"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🔥  0-day streak"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <Button
        android:id="@+id/widToggle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="START FOCUS"
        android:textColor="#FF121212"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widStop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="END SESSION"
        android:textColor="#FF121212"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
