<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_weekly_summary_gradient"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_book"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="WEEKLY SUMMARY"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Date Range (Timeline) -->
        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="JUL 28 – AUG 03"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.7"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Trophy -->
        <ImageView
            android:id="@+id/ivTrophy"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trophy_placeholder"
            app:layout_constraintTop_toBottomOf="@id/tvQuote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Streak Badge -->
        <TextView
            android:id="@+id/tvStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_streak_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🔥 5-day streak"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ivTrophy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Metrics -->
        <LinearLayout
            android:id="@+id/metricsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStreakBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Total Study Time -->
            <include
                android:id="@+id/rowTotalTime"
                layout="@layout/item_metric_row"
                android:layout_width="match_parent"
                android:layout_height="56dp" />

            <!-- Best Day -->
            <include
                android:id="@+id/rowBestDay"
                layout="@layout/item_metric_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp" />

            <!-- Goal Progress -->
            <include
                android:id="@+id/rowGoalProgress"
                layout="@layout/item_metric_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp" />

            <!-- vs Last Week -->
            <include
                android:id="@+id/rowVsLastWeek"
                layout="@layout/item_metric_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp" />

            <!-- Focus / Break Split -->
            <include
                android:id="@+id/rowFocusBreak"
                layout="@layout/item_metric_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Daily Motivational Quote -->
        <TextView
            android:id="@+id/tvQuoteBottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/metricsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Branding Footer -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Made with StudyTimer"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.55"
            android:letterSpacing="0.14"
            app:layout_constraintTop_toBottomOf="@id/tvQuoteBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>